# AWS credentials come from this profile or the normal AWS credential chain.
AWS_PROFILE=default
AWS_REGION=us-east-2
TF_STATE_BUCKET=replace-with-a-globally-unique-state-bucket
PROJECT_NAME=quoptuna

# Buy the domain from any registrar and delegate DNS to this Route 53 zone.
DOMAIN_NAME=quoptuna.example.com
ROUTE53_ZONE_ID=Z0000000000000000000

# Cost/performance controls.
INSTANCE_TYPE=t3.large
ROOT_VOLUME_SIZE=50

# Supabase PostgreSQL. Use SSL and an IPv4-compatible pooler endpoint.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
OPTUNA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
OPTUNA_DB_SCHEMA=optuna

AUTH0_DOMAIN=example.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH_ALLOWED_EMAILS=researcher@example.com,supervisor@example.edu
AUTH_REQUIRE_VERIFIED_EMAIL=true

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
